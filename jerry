    local offeredItemIds = {}


    local function getKindDisplayName(kind)
        local kindData = kind and KindDB[kind]

        return kindData
            and tostring(kindData.name or "")
            or ""
    end


    local function matchesItemForm(itemData, itemName, itemForm)
        if not itemData or not itemData.kind then
            return false
        end

        local targetNameLower =
            string.lower(tostring(itemName or ""))
        local displayLower =
            string.lower(getKindDisplayName(itemData.kind))
        local kindLower =
            string.lower(tostring(itemData.kind))

        if displayLower ~= targetNameLower
            and kindLower ~= targetNameLower then
            return false
        end

        local properties = itemData.properties or {}
        local isNeon = properties.neon == true
        local isMegaNeon = properties.mega_neon == true
        local formLower = string.lower(tostring(itemForm or ""))

        if formLower == "" or formLower == "normal" then
            return not isNeon and not isMegaNeon
        elseif formLower == "neon" then
            return isNeon and not isMegaNeon
        elseif formLower == "mega" then
            return isMegaNeon
        end

        return false
    end


    local function refreshPetEgg()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

        if not playerGui then
            return false
        end

        local fired = false

        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant:IsA("BindableEvent")
                and descendant.Name == "RefreshSelected" then

                pcall(function()
                    descendant:Fire()
                end)

                fired = true
            end
        end

        return fired
    end


