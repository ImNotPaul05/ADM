    local function countMatchingItems()
        local dataStore = ClientData.get_data()
        local playerData =
            dataStore
            and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
        local pets =
            playerData
            and playerData.inventory
            and playerData.inventory.pets

        if not pets then
            return nil
        end

        local count = 0
        for _, itemData in pairs(pets) do
            if matchesItemForm(
                itemData,
                TARGET_ITEM_NAME,
                TARGET_ITEM_FORM
            ) then
                count += 1
            end
        end

        return count
    end


