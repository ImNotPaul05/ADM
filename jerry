            Url = "https://api.farmsync.cloud/api/self/autochangeconfigs/"
                .. HttpService:UrlEncode(configId),
            Method = "PUT",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. apiKey,
