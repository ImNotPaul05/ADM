            name = farmSyncConfig.ConfigName or "Receiver item threshold",
            group_id = farmSyncConfig.GroupId or "",
            from_child_folder_id = farmSyncConfig.StartFolderId,
            to_child_folder_id = farmSyncConfig.EndFolderId,
