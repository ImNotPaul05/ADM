    local function getCurrentFarmSyncAccountContext(farmSyncConfig)
        local requestFunction =
            request
            or http_request
            or (syn and syn.request)

        if type(requestFunction) ~= "function" then
            warn("[FARMSYNC] HTTP request function is unavailable; device account details cannot be read.")
            return nil
        end

        local apiKey = farmSyncConfig.ApiKey
        if type(apiKey) ~= "string" or apiKey == "" then
            warn("[FARMSYNC] API key is missing; device account details cannot be read.")
            return nil
        end

        local headers = {
            ["Authorization"] = "Bearer " .. apiKey,
        }

        local function getJson(url, description)
            local success, response = pcall(function()
                return requestFunction({
                    Url = url,
                    Method = "GET",
                    Headers = headers,
                })
            end)

            if not success then
                warn("[FARMSYNC] " .. description .. " request failed:", response)
                return nil
            end

            local statusCode =
                response
                and (response.StatusCode or response.Status)
            if type(statusCode) ~= "number"
                or statusCode < 200
                or statusCode >= 300 then
                warn(
                    "[FARMSYNC] " .. description .. " request was rejected:",
                    statusCode,
                    response and response.Body
                )
                return nil
            end

            local decodedSuccess, decoded = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)
            if not decodedSuccess then
                warn(
                    "[FARMSYNC] " .. description .. " response was invalid JSON:",
                    response and response.Body
                )
                return nil
            end

            return decoded
        end

        local devicesResponse =
            getJson("https://api.farmsync.cloud/api/devices/", "Device list")
        if not devicesResponse then
            return nil
        end

        local devices = devicesResponse
        if type(devicesResponse) == "table"
            and type(devicesResponse.devices) == "table" then
            devices = devicesResponse.devices
        end
        if type(devices) ~= "table" then
            warn("[FARMSYNC] Device list response did not contain a device array.")
            return nil
        end

        for _, device in ipairs(devices) do
            if type(device) == "table"
                and type(device.id) == "string"
                and device.id ~= "" then
                if not device.id:match("^[%w%-]+$") then
                    warn("[FARMSYNC] Skipping device with an invalid ID format.")
                    continue
                end

                local accountsResponse = getJson(
                    "https://api.farmsync.cloud/api/devices/"
                        .. device.id
                        .. "/accounts",
                    "Device account list"
                )

                if type(accountsResponse) == "table" then
                    for _, account in ipairs(accountsResponse) do
                        if type(account) == "table"
                            and account.username == LocalPlayer.Name then
                            if account.enabled ~= true then
                                warn(
                                    "[FARMSYNC] Current device account is not enabled:",
                                    LocalPlayer.Name
                                )
                                return nil
                            end

                            if type(account.device_id) ~= "string"
                                or account.device_id == ""
                                or type(account.config_id) ~= "string"
                                or account.config_id == ""
                                or type(account.login_at) ~= "number" then
                                warn(
                                    "[FARMSYNC] Current account record is missing device_id, config_id, or numeric login_at:",
                                    LocalPlayer.Name
                                )
                                return nil
                            end

                            print(
                                "[FARMSYNC] Found current account device and config:",
                                LocalPlayer.Name
                            )
                            return {
                                deviceId = account.device_id,
                                configId = account.config_id,
                                enabled = account.enabled,
                                loginAt = account.login_at,
                            }
                        end
                    end
                end
            end
        end

        warn(
            "[FARMSYNC] Current account was not found in any device account list:",
            LocalPlayer.Name
        )
        return nil
    end


    local function markFarmSyncAccountDone(farmSyncConfig)
        local requestFunction =
            request
            or http_request
            or (syn and syn.request)

        if type(requestFunction) ~= "function" then
            warn("[FARMSYNC] HTTP request function is unavailable; account was not marked done.")
            return false
        end

        local apiKey = farmSyncConfig.ApiKey
        local destinationFolderId = farmSyncConfig.EndFolderId
        if type(apiKey) ~= "string"
            or apiKey == ""
            or type(destinationFolderId) ~= "string"
            or destinationFolderId == "" then
            warn("[FARMSYNC] API key or Completed folder ID is missing; account was not marked done.")
            return false
        end

        local requestOptions = {
            Url = "https://api.farmsync.cloud/api/self/accounts/mark-done",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. apiKey,
            },
            Body = HttpService:JSONEncode({
                usernames = {LocalPlayer.Name},
                target_folder_id = destinationFolderId,
            }),
        }

        local success, response = pcall(function()
            return requestFunction(requestOptions)
        end)

        if not success then
            warn("[FARMSYNC] Mark-done request failed:", response)
            return false
        end

        local statusCode =
            response
            and (response.StatusCode or response.Status)

        if type(statusCode) ~= "number"
            or statusCode < 200
            or statusCode >= 300 then
            warn(
                "[FARMSYNC] Mark-done request was rejected:",
                statusCode,
                response and response.Body
            )
            return false
        end

        local decodedSuccess, decodedResponse = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not decodedSuccess or type(decodedResponse) ~= "table" then
            warn(
                "[FARMSYNC] Mark-done response was not valid JSON:",
                response and response.Body
            )
            return false
        end

        local markedDone = false
        local disposition
        for _, resultKey in ipairs({"moved_only", "swapped"}) do
            local usernames = decodedResponse[resultKey]
            if type(usernames) == "table" then
                for _, username in ipairs(usernames) do
                    if username == LocalPlayer.Name then
                        markedDone = true
                        disposition = resultKey
                        break
                    end
                end
            end
            if markedDone then
                break
            end
        end

        if not markedDone then
            warn(
                "[FARMSYNC] Account was not marked done:",
                decodedResponse.message or "FarmSync did not report this account as moved."
            )
            return false
        end

        print(
            "[FARMSYNC] Marked account done and moved it to Completed:",
            LocalPlayer.Name
        )
        return true, disposition
    end


    local function queryNextFarmSyncAccount(farmSyncConfig)
        local requestFunction =
            request
            or http_request
            or (syn and syn.request)

        if type(requestFunction) ~= "function" then
            warn("[FARMSYNC] HTTP request function is unavailable; next account was not queried.")
            return nil
        end

        local apiKey = farmSyncConfig.ApiKey
        local sourceFolderId = farmSyncConfig.StartFolderId
        if type(apiKey) ~= "string"
            or apiKey == ""
            or type(sourceFolderId) ~= "string"
            or sourceFolderId == "" then
            warn("[FARMSYNC] API key or Original folder ID is missing; next account was not queried.")
            return nil
        end

        local requestOptions = {
            Url = "https://api.farmsync.cloud/api/self/accounts",
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. apiKey,
            },
        }

        local success, response = pcall(function()
            return requestFunction(requestOptions)
        end)

        if not success then
            warn("[FARMSYNC] Next-account query failed:", response)
            return nil
        end

        local statusCode = response and (response.StatusCode or response.Status)
        if type(statusCode) ~= "number"
            or statusCode < 200
            or statusCode >= 300 then
            warn(
                "[FARMSYNC] Next-account query was rejected:",
                statusCode,
                response and response.Body
            )
            return nil
        end

        local decodedSuccess, decodedResponse = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not decodedSuccess or type(decodedResponse) ~= "table" then
            warn(
                "[FARMSYNC] Account list returned an invalid response:",
                response and response.Body
            )
            return nil
        end

        local accounts = decodedResponse
        if type(decodedResponse.accounts) == "table" then
            accounts = decodedResponse.accounts
        end
        if type(accounts) ~= "table" then
            warn("[FARMSYNC] Account list response did not contain an account array.")
            return nil
        end

        local queuedAccounts = {}
        for _, account in ipairs(accounts) do
            if type(account) == "table"
                and account.folder_id == sourceFolderId
                and account.enabled == false
                and type(account.username) == "string"
                and account.username ~= ""
                and account.username ~= LocalPlayer.Name then
                table.insert(queuedAccounts, account.username)
            end
        end

        table.sort(queuedAccounts)
        local nextUsername = queuedAccounts[1]
        if not nextUsername then
            print(
                "[FARMSYNC] Account list loaded, but no disabled account matched Original folder:",
                sourceFolderId
            )
            return nil
        end

        print("[FARMSYNC] Next queued account is:", nextUsername)
        return nextUsername
    end


    local function assignFarmSyncAccountToDevice(
        farmSyncConfig,
        username,
        accountContext
    )
        local requestFunction =
            request
            or http_request
            or (syn and syn.request)

        if type(requestFunction) ~= "function" then
            warn("[FARMSYNC] HTTP request function is unavailable; next account was not assigned.")
            return false
        end

        local apiKey = farmSyncConfig.ApiKey
        local deviceId = accountContext and accountContext.deviceId
        local configId = accountContext and accountContext.configId
        local loginAt = accountContext and accountContext.loginAt
        if type(apiKey) ~= "string"
            or apiKey == ""
            or type(deviceId) ~= "string"
            or deviceId == ""
            or type(configId) ~= "string"
            or configId == ""
            or type(loginAt) ~= "number"
            or type(username) ~= "string"
            or username == "" then
            warn("[FARMSYNC] API key, device ID, config ID, numeric login_at, or next username is missing; account was not assigned.")
            return false
        end

        local requestOptions = {
            Url = "https://api.farmsync.cloud/api/self/accounts/move",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. apiKey,
            },
            Body = HttpService:JSONEncode({
                usernames = {username},
                device_id = deviceId,
                config_id = configId,
                enabled = true,
                login_at = loginAt,
            }),
        }

        local success, response = pcall(function()
            return requestFunction(requestOptions)
        end)

        if not success then
            warn("[FARMSYNC] Device account assignment failed:", response)
            return false
        end

        local statusCode = response and (response.StatusCode or response.Status)
        if type(statusCode) ~= "number"
            or statusCode < 200
            or statusCode >= 300 then
            warn(
                "[FARMSYNC] Device account assignment was rejected:",
                statusCode,
                response and response.Body
            )
            return false
        end

        local decodedSuccess, decodedResponse = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not decodedSuccess
            or type(decodedResponse) ~= "table"
            or type(decodedResponse.message) ~= "string" then
            warn(
                "[FARMSYNC] Device assignment returned an unexpected response:",
                response and response.Body
            )
            return false
        end

        local movedCount = tonumber(
            string.match(decodedResponse.message, "^Moved%s+(%d+)%s+accounts?$")
        )
        if movedCount ~= 1 then
            warn(
                "[FARMSYNC] FarmSync did not confirm assigning exactly one account:",
                decodedResponse.message
            )
            return false
        end

        print("[FARMSYNC] Assigned next account to device:", username)
        return true
    end


    local function startReceiverAmountTrigger()
        local farmSyncConfig =
            type(AccountFeatures) == "table"
            and type(AccountFeatures.FarmSync) == "table"
            and AccountFeatures.FarmSync

        if not farmSyncConfig then
            warn("[RECEIVER] FarmSync configuration is missing or invalid.")
            return
        end

        if farmSyncConfig.AutoChange ~= true or ForceReceiver ~= true then
            print(
                "[RECEIVER] Amount trigger disabled; AutoChange and ForceReceiver must both be true."
            )
            return
        end

        local amountLimit = tonumber(Amount)
        local amountIsUnset =
            Amount == nil
            or (type(Amount) == "string" and Amount:match("^%s*$") ~= nil)

        if amountIsUnset then
            return
        end

        if not amountLimit
            or amountLimit <= 0
            or amountLimit % 1 ~= 0 then
            warn("[RECEIVER] Amount trigger requires a positive whole-number Amount.")
            return
        end

        if not updateFarmSyncAutoChangeConfig(farmSyncConfig, amountLimit) then
            warn("[RECEIVER] FarmSync AutoChange config update failed; receiver watcher not started.")
            return
        end

        if not waitForInventoryReady() then
            warn("[RECEIVER] Inventory was not ready; amount trigger was not started.")
            return
        end

        local triggerEvent =
            LocalPlayer:FindFirstChild("FarmSyncReceiverAmountReached")

        if triggerEvent and not triggerEvent:IsA("BindableEvent") then
            warn("[RECEIVER] FarmSyncReceiverAmountReached exists but is not a BindableEvent.")
            return
        end

        if not triggerEvent then
            triggerEvent = Instance.new("BindableEvent")
            triggerEvent.Name = "FarmSyncReceiverAmountReached"
            triggerEvent.Parent = LocalPlayer
        end

        local baselineCount = countMatchingItems()
        if baselineCount == nil then
            warn("[RECEIVER] Could not read inventory baseline; amount trigger was not started.")
            return
        end

        print(
            "[RECEIVER] Watching for",
            amountLimit,
            TARGET_ITEM_NAME,
            "items; current matching count:",
            baselineCount
        )

        task.spawn(function()
            while true do
                task.wait(0.25)

                local currentCount = countMatchingItems()
                local receivedCount =
                    currentCount
                    and (currentCount - baselineCount)

                if receivedCount and receivedCount >= amountLimit then
                    local result = {
                        playerName = LocalPlayer.Name,
                        itemName = TARGET_ITEM_NAME,
                        itemForm = TARGET_ITEM_FORM,
                        amount = amountLimit,
                        baselineCount = baselineCount,
                        currentCount = currentCount,
                        receivedCount = receivedCount,
                        autoChange = farmSyncConfig.AutoChange,
                    }

                    print(
                        "[RECEIVER] Amount trigger reached or passed:",
                        result.receivedCount,
                        TARGET_ITEM_NAME
                    )
                    triggerEvent:Fire(result)
                    task.spawn(function()
                        local currentAccountContext =
                            getCurrentFarmSyncAccountContext(farmSyncConfig)
                        local markedDone, disposition =
                            markFarmSyncAccountDone(farmSyncConfig)
                        if not markedDone then
                            return
                        end

                        if disposition == "swapped" then
                            print("[FARMSYNC] FarmSync already swapped in a replacement account.")
                            return
                        end

                        local nextUsername =
                            queryNextFarmSyncAccount(farmSyncConfig)

                        if nextUsername then
                            if not currentAccountContext then
                                warn(
                                    "[FARMSYNC] Current account was moved to Completed, but the replacement was not assigned because device_id/config_id lookup failed."
                                )
                                return
                            end

                            assignFarmSyncAccountToDevice(
                                farmSyncConfig,
                                nextUsername,
                                currentAccountContext
                            )
                        end
                    end)
                    return
                end
            end
        end)
    end


    startReceiverAmountTrigger()


