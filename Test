-- Cache the remotes once
local AcceptNeg = API:WaitForChild("TradeAPI/AcceptNegotiation")
local ConfirmTrade = API:WaitForChild("TradeAPI/ConfirmTrade")

local function RunTradeAutomation()
    while true do
		if MainAccUsername and #MainAccUsername > 0 and MainAccUsername[1] ~= "" then
			for _, playerName in ipairs(MainAccUsername) do
				if Players:FindFirstChild(playerName) then
					AcceptNeg:FireServer()
					ConfirmTrade:FireServer()
					break
				end
			end
		end
        task.wait(1) -- Wait 1 second before the next loop
    end
end

-- Start the loop in the background
task.spawn(RunTradeAutomation)
