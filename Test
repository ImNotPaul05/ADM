local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer


local TARGET_ITEM_NAME = "retired_egg"
local TARGET_ITEM_FORM = "NORMAL" -- NORMAL, NEON, or MEGA_NEON
local ForceReceiver = false 
-- =================================================

local addItemRemote = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AddItemToOffer")
local sendTradeRemote = ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
local tradeFunction = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptOrDeclineTradeRequest")
local AcceptNeg = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/AcceptNegotiation")
local ConfirmTrade = ReplicatedStorage:WaitForChild("API"):WaitForChild("TradeAPI/ConfirmTrade")
local API = ReplicatedStorage:WaitForChild("API")

local successClientData, ClientData = pcall(function()
	return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
end)

local function getMultipleUniqueIdsByName(itemName, itemForm, limit)
	if not successClientData or not ClientData then
		return {}
	end

	local dataStore = ClientData.get_data()
	local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])
	
	if not playerData or not playerData.inventory or not playerData.inventory.pets then
		return {}
	end

	local uniqueIds = {}
	for uniqueId, itemData in pairs(playerData.inventory.pets) do
		if itemData and itemData.kind == itemName then
			local properties = itemData.properties or {}
			local isNeon = properties.neon == true
			local isMegaNeon = properties.mega_neon == true
			local matchesForm = itemForm == "NEON" and isNeon and not isMegaNeon
				or itemForm == "MEGA_NEON" and isMegaNeon
				or itemForm == "NORMAL" and not isNeon and not isMegaNeon

			if matchesForm then
				table.insert(uniqueIds, uniqueId)
				if #uniqueIds >= limit then
					break
				end
			end
		end
	end
	return uniqueIds
end

local function isCurrentlyInTrade()
	if not successClientData or not ClientData then
		return false
	end
	local success, tradeData = pcall(function()
		return ClientData.get("trade")
	end)
	return success and tradeData and tradeData.current_trade ~= nil
end

-- Sequential Trade Rotation Manager
task.spawn(function()
	local currentIndex = 1

	while true do
		if MainAccUsername and #MainAccUsername > 0 and MainAccUsername[1] ~= "" then
			local targetName = MainAccUsername[currentIndex]
			local targetPlayer = Players:FindFirstChild(targetName)

			-- If the user is online, proceed with trade cycle
			if targetPlayer then
				print("Targeting user: " .. targetName)

				-- Send trade request if not currently in a trade session
				if not isCurrentlyInTrade() then
					if sendTradeRemote and sendTradeRemote:IsA("RemoteEvent") then
						sendTradeRemote:FireServer(targetPlayer)
					end
				else
					-- We are in a trade, add items and progress negotiation
					local uniqueIds = getMultipleUniqueIdsByName(TARGET_ITEM_NAME, TARGET_ITEM_FORM, 18)
					for _, uniqueId in ipairs(uniqueIds) do
						pcall(function()
							addItemRemote:FireServer(uniqueId)
						end)
					end

					-- Accept negotiation and confirm trade
					pcall(function()
						AcceptNeg:FireServer()
						ConfirmTrade:FireServer()
					end)

					-- Wait for trade window to close or clear before moving forward
					local timeout = 0
					while isCurrentlyInTrade() and timeout < 30 do
						task.wait(1)
						timeout = timeout + 1
					end

					print("Trade completed or timed out with: " .. targetName .. ". Moving to next user.")
					
					-- Move to the next user in sequential order, loop back to 1 after the last index
					currentIndex = currentIndex + 1
					if currentIndex > #MainAccUsername then
						currentIndex = 1
					end
				end
			else
				-- Skip user if offline and move to the next index immediately
				print("User offline or not found: " .. tostring(targetName) .. ". Skipping.")
				currentIndex = currentIndex + 1
				if currentIndex > #MainAccUsername then
					currentIndex = 1
				end
			end
		end

		if ForceReceiver then
			for _, targetPlayer in ipairs(Players:GetPlayers()) do
				if targetPlayer ~= LocalPlayer then
					pcall(function()
						tradeFunction:InvokeServer(targetPlayer, true)
					end)
				end
			end
		end

		task.wait(1)
	end
end)
