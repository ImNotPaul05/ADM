local rotateAfterMinutes = ROTATE_AFTER_MINUTES
if rotateAfterMinutes == nil then
	rotateAfterMinutes = 1
end

local pollIntervalSeconds = POLL_INTERVAL_SECONDS
if pollIntervalSeconds == nil then
	pollIntervalSeconds = 10
end
    
local PRIVATE_FARMSYNC_SETTINGS = {
	ApiKey = "a39e5c73a81bed26e97671961215c6044cc76d4b2449a3e4bf254fa4fa8f9f1b",
}

local function failAndLeave(message)
	warn("[AutoChange] Fatal error: " .. tostring(message))
	local player = game:GetService("Players").LocalPlayer
	if player then
		task.defer(function()
			player:Kick("[AutoChange] Failed to initialize. Leaving server.")
		end)
	end
end

local FarmSync = AccountFeatures and AccountFeatures.FarmSync
if not FarmSync or not FarmSync.AutoChange then
	failAndLeave("FarmSync AutoChange is disabled or not configured.")
	return
end

local apiKey = PRIVATE_FARMSYNC_SETTINGS.ApiKey
if (type(apiKey) ~= "string" or apiKey == "")
	and type(FarmSync.ApiKey) == "string" then
	apiKey = FarmSync.ApiKey
end

if type(apiKey) ~= "string" or apiKey == "" then
	failAndLeave("Add a valid FarmSync API key to PRIVATE_FARMSYNC_SETTINGS.ApiKey.")
	return
end

local StartFolderId = FarmSync.StartFolderId
local EndFolderId = FarmSync.EndFolderId
if type(StartFolderId) ~= "string" or StartFolderId == ""
	or type(EndFolderId) ~= "string" or EndFolderId == "" then
	failAndLeave("Configure the Original and Completed folder IDs in AccountFeatures.FarmSync.")
	return
end

if type(rotateAfterMinutes) ~= "number" or rotateAfterMinutes <= 0 then
	failAndLeave("ROTATE_AFTER_MINUTES must be a positive number.")
	return
end
if type(pollIntervalSeconds) ~= "number" or pollIntervalSeconds <= 0 then
	failAndLeave("POLL_INTERVAL_SECONDS must be a positive number.")
	return
end

local API_BASE = "https://api.farmsync.cloud/api"
local HttpRequest = request or http_request
if not HttpRequest and syn then
	HttpRequest = syn.request
end
if type(HttpRequest) ~= "function" then
	failAndLeave("No supported HTTP request function is available.")
	return
end

local function requestJson(method, path, body)
	print("[AutoChange] FarmSync request:", method, path)
	local headers = {
		["Content-Type"] = "application/json",
		["Authorization"] = "Bearer " .. apiKey,
	}
	local requestOptions = {
		Url = API_BASE .. path,
		Method = method,
		Headers = headers,
	}

	if body then
		requestOptions.Body = game:GetService("HttpService"):JSONEncode(body)
	end

	local ok, response = pcall(HttpRequest, requestOptions)
	if not ok then
		warn("[AutoChange] Request failed before receiving a response:", tostring(response))
		return nil, "HTTP request failed: " .. tostring(response)
	end

	if type(response) ~= "table" then
		warn("[AutoChange] Request returned no response object:", method, path)
		return nil, "HTTP request returned no response object."
	end

	local statusCode = tonumber(response.StatusCode or response.Status)
	if not statusCode or statusCode < 200 or statusCode >= 300 then
		local responseBody = tostring(response.Body or "")
		warn("[AutoChange] FarmSync request rejected:", statusCode or "unknown", path,
			string.sub(responseBody, 1, 300))
		return nil, "FarmSync returned HTTP " .. tostring(statusCode or "unknown")
			.. ": " .. responseBody
	end

	if not response.Body or response.Body == "" then
		return {}
	end

	local decodedOk, decoded = pcall(
		game:GetService("HttpService").JSONDecode,
		game:GetService("HttpService"),
		response.Body
	)
	if not decodedOk then
		warn("[AutoChange] FarmSync returned invalid JSON for", path, tostring(decoded))
		return nil, "FarmSync returned invalid JSON: " .. tostring(decoded)
	end

	return decoded
end

local function extractRecords(response, preferredKey)
	if type(response) ~= "table" then
		return nil
	end

	if type(response[preferredKey]) == "table" then
		return response[preferredKey]
	end
	if type(response.data) == "table" then
		if type(response.data[preferredKey]) == "table" then
			return response.data[preferredKey]
		end
		return response.data
	end
	if #response > 0 then
		return response
	end

	return nil
end

local function getCurrentAccount()
	local currentUsername = game:GetService("Players").LocalPlayer.Name
	print("[AutoChange] Looking up active FarmSync account for", currentUsername)
	local devicesResponse, devicesError = requestJson("GET", "/devices/")
	if not devicesResponse then
		return nil, devicesError
	end

	local devices = extractRecords(devicesResponse, "devices")
	if not devices then
		warn("[AutoChange] Device response did not include a recognized device list.")
		return nil, "FarmSync device response did not contain a device list."
	end
	print("[AutoChange] Checking", #devices, "FarmSync device(s).")

	for _, device in ipairs(devices) do
		if type(device) == "table" then
			local deviceId = device.id or device.device_id
			if type(deviceId) == "string"
				and deviceId ~= ""
				and deviceId:match("^[%w%-]+$") then
				local accountsResponse, accountsError = requestJson(
					"GET",
					"/devices/" .. tostring(deviceId) .. "/accounts"
				)
				if accountsResponse then
					local accounts = extractRecords(accountsResponse, "accounts")
					if accounts then
						for _, account in ipairs(accounts) do
							if type(account) == "table"
							and account.username == currentUsername
							and account.enabled == true then
								local loginAt = tonumber(account.login_at)
								if not loginAt or loginAt <= 0 then
									loginAt = DateTime.now().UnixTimestampMillis
									print("[AutoChange] FarmSync returned a missing/zero login_at for",
										account.username, "; starting the timer from now.")
								end
								print("[AutoChange] Active account found:", account.username,
									"login_at:", tostring(loginAt))
								return {
									username = account.username,
									deviceId = account.device_id,
									configId = account.config_id or account.configId,
									loginAt = loginAt,
								}
							end
						end
					end
				else
					warn("[AutoChange] Could not read accounts for device "
						.. tostring(deviceId) .. ": " .. tostring(accountsError))
				end
			end
		end
	end

	return nil, "No enabled account was found on the FarmSync devices."
end

local function getNextQueuedAccount()
	print("[AutoChange] Searching Original folder for a disabled queued account.")
	local response, requestError = requestJson("GET", "/self/accounts")
	if not response then
		return nil, requestError
	end

	local accounts = extractRecords(response, "accounts")
	if not accounts then
		warn("[AutoChange] Account list response did not include a recognized account list.")
		return nil, "FarmSync account response did not contain an account list."
	end
	print("[AutoChange] FarmSync returned", #accounts, "account record(s).")

	local queuedAccounts = {}
	for _, account in ipairs(accounts) do
		if type(account) == "table" and type(account.username) == "string"
			and account.username ~= "" then
			local folderId = account.folder_id or account.folderId
			if tostring(folderId) == tostring(StartFolderId)
				and account.enabled == false
				and string.lower(account.username)
					~= string.lower(game:GetService("Players").LocalPlayer.Name) then
				table.insert(queuedAccounts, account)
			end
		end
	end

	table.sort(queuedAccounts, function(left, right)
		return string.lower(left.username) < string.lower(right.username)
	end)

	if queuedAccounts[1] then
		print("[AutoChange] Next queued account selected:", queuedAccounts[1].username)
	else
		print("[AutoChange] No disabled account left in the configured Original folder.")
		print("[AutoChange] Last account condition: original queue is empty for folder_id " .. tostring(StartFolderId) .. ".")
		warn("[AutoChange] No disabled account is available in the Original folder; leaving the current account in place.")
	end

	return queuedAccounts[1]
end

local function rotateAccount(current, nextAccount)
	print("[AutoChange] Target reached. Marking", current.username, "as done.")
	local markDoneResponse, markDoneError = requestJson(
		"POST",
		"/self/accounts/mark-done",
		{
			usernames = { current.username },
			target_folder_id = EndFolderId,
		}
	)
	if not markDoneResponse then
		return false, "Could not mark current account done: " .. tostring(markDoneError)
	end

	local disposition
	for _, resultKey in ipairs({ "moved_only", "swapped" }) do
		local usernames = markDoneResponse[resultKey]
		if type(usernames) == "table" then
			for _, username in ipairs(usernames) do
				if string.lower(tostring(username)) == string.lower(current.username) then
					disposition = resultKey
					break
				end
			end
		end
		if disposition then
			break
		end
	end

	if not disposition then
		warn("[AutoChange] Mark-done response did not list the current account in moved_only or swapped.")
		return false, "FarmSync did not confirm that the current account was marked done."
	end

	if disposition == "swapped" then
		print("[AutoChange] FarmSync reports that it already swapped in a replacement account.")
		return true, "FarmSync already swapped in a replacement account."
	end

	print("[AutoChange] Assigning", nextAccount.username, "to device", current.deviceId)
	local moveResponse, moveError = requestJson(
		"POST",
		"/self/accounts/move",
		{
			usernames = { nextAccount.username },
			device_id = current.deviceId,
			config_id = current.configId,
			enabled = true,
			login_at = DateTime.now().UnixTimestampMillis,
		}
	)
	if not moveResponse then
		return false, "Current account was marked done, but the next account move failed: "
			.. tostring(moveError)
	end

	local movedCount = type(moveResponse.message) == "string"
		and tonumber(string.match(moveResponse.message, "^Moved%s+(%d+)%s+accounts?$"))
		or nil
	if movedCount ~= 1 then
		warn("[AutoChange] Move response did not confirm exactly one account:", tostring(moveResponse.message))
		return false, "Current account was marked done, but FarmSync did not confirm moving exactly one queued account."
	end

	return true, "Moved " .. tostring(nextAccount.username) .. " onto the device."
end

local currentAccount, currentError = getCurrentAccount()
if not currentAccount then
	warn("[AutoChange] " .. tostring(currentError))
	return
end

print("[AutoChange] Monitoring", currentAccount.username,
	"for", rotateAfterMinutes, "minute(s).")

if not currentAccount.loginAt or currentAccount.loginAt <= 0 then
	print("[AutoChange] Current account has no valid login_at timestamp; starting the timer from now.")
	currentAccount.loginAt = DateTime.now().UnixTimestampMillis
end
if type(currentAccount.deviceId) ~= "string" or currentAccount.deviceId == ""
	or type(currentAccount.configId) ~= "string" or currentAccount.configId == "" then
	warn("[AutoChange] Current device account is missing its device_id or config_id.")
	return
end

local rotationDurationMs = rotateAfterMinutes * 60 * 1000
local elapsedMs = DateTime.now().UnixTimestampMillis - currentAccount.loginAt
if elapsedMs < 0 then
	warn("[AutoChange] Current account login_at is in the future; refusing to rotate.")
	return
end

print(string.format("[AutoChange] Timer state: %.1f minute(s) elapsed; %.1f minute(s) remaining.",
	elapsedMs / 60000, math.max(0, rotationDurationMs - elapsedMs) / 60000))
while elapsedMs < rotationDurationMs do
	local remainingSeconds = (rotationDurationMs - elapsedMs) / 1000
	task.wait(math.min(pollIntervalSeconds, remainingSeconds))
	elapsedMs = DateTime.now().UnixTimestampMillis - currentAccount.loginAt
	local remainingMs = math.max(0, rotationDurationMs - elapsedMs)
	print(string.format("[AutoChange] Countdown: %.0f second(s) remaining.",
		remainingMs / 1000))
end

print("[AutoChange] Time threshold reached; checking current account and queue.")
local refreshedCurrent, refreshError = getCurrentAccount()
if not refreshedCurrent then
	warn("[AutoChange] " .. tostring(refreshError))
	return
end

if string.lower(refreshedCurrent.username) ~= string.lower(currentAccount.username)
	or refreshedCurrent.deviceId ~= currentAccount.deviceId then
	warn("[AutoChange] The active account changed while waiting; not rotating the stale account.")
	return
end

local nextAccount, nextError = getNextQueuedAccount()
if not nextAccount then
	if nextError then
		warn("[AutoChange] Could not find the next queued account: " .. tostring(nextError))
	else
		print("[AutoChange] Final empty-queue check: no remaining disabled account found in Original folder.")
		warn("[AutoChange] No disabled account is available in the Original folder; leaving the current account in place.")
	end
	return
end

local success, result = rotateAccount(refreshedCurrent, nextAccount)
if not success then
	warn("[AutoChange] " .. tostring(result))
	return
end

print("[AutoChange] " .. tostring(result))
