local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local TARGET_ITEM_NAME = "retired_egg"
local TARGET_ITEM_FORM = "NORMAL"

local addItemRemote = ReplicatedStorage
    :WaitForChild("API")
    :WaitForChild("TradeAPI/AddItemToOffer")

local successClientData, ClientData = pcall(function()
    return require(
        ReplicatedStorage
            :WaitForChild("ClientModules")
            :WaitForChild("Core")
            :WaitForChild("ClientData")
    )
end)

local function getMultipleUniqueIdsByName(itemName, itemForm, limit)
    if not successClientData or not ClientData then
        return {}
    end

    local dataStore = ClientData.get_data()
    local playerData = dataStore and (
        dataStore[LocalPlayer]
        or dataStore[LocalPlayer.Name]
    )

    if not playerData
        or not playerData.inventory
        or not playerData.inventory.pets then
        return {}
    end

    local uniqueIds = {}
    local formLower = itemForm and string.lower(itemForm) or ""

    for uniqueId, itemData in pairs(playerData.inventory.pets) do
        if itemData and itemData.kind == itemName then
            local properties = itemData.properties or {}

            local isNeon = properties.neon == true
            local isMegaNeon = properties.mega_neon == true

            local matchesForm =
                (formLower == "neon" and isNeon and not isMegaNeon)
                or (formLower == "mega" and isMegaNeon)
                or (formLower == "normal" and not isNeon and not isMegaNeon)

            if matchesForm then
                table.insert(uniqueIds, uniqueId)

                if #uniqueIds >= limit then
                    break
                end
            end
        end
    end

    return uniqueIds
end

local function isTradeActive()
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if gui:IsA("GuiObject") and gui.Visible then
            local name = string.lower(gui.Name)

            if string.find(name, "trade", 1, true)
                or string.find(name, "negotiat", 1, true) then
                return true
            end
        end
    end

    return false
end

local hasAddedItems = false

while true do
    local active = isTradeActive()

    if active then
        if not hasAddedItems then
            local uniqueIds = getMultipleUniqueIdsByName(
                TARGET_ITEM_NAME,
                TARGET_ITEM_FORM,
                18
            )

            if #uniqueIds > 0 then
                print("Found", #uniqueIds, TARGET_ITEM_NAME)

                for _, uniqueId in ipairs(uniqueIds) do
                    pcall(function()
                        addItemRemote:FireServer(uniqueId)
                    end)

                end

                hasAddedItems = true
                print("Finished adding items")
            end
        end
    else
        hasAddedItems = false
    end

    task.wait(0.25)
end
