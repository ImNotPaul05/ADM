local function HVNJ_fake_script() -- TradeButton.LocalScript 
	local script = Instance.new('LocalScript', TradeButton)

	local button = script.Parent
	local orangedash = button:FindFirstAncestor("Orangedash")
	local page1 = orangedash:WaitForChild("Page1")
