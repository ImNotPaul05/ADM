titleBar.BackgroundColor3 = Color3.fromRGB(35, 39, 49)
titleBar.BorderSizePixel = 0
titleBar.Text = "  UI DRAG INSPECTOR"
titleBar.TextColor3 = Color3.fromRGB(240, 243, 250)
titleBar.TextSize = 16
