local function WGFO_fake_script() -- ImageButton.LocalScript 
	local script = Instance.new('LocalScript', ImageButton)

	local button = script.Parent
	local circle = button:WaitForChild("Circle")
	
	local green = false
	
	circle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	
	button.Activated:Connect(function()
		green = not green
	
		if green then
			circle.BackgroundColor3 = Color3.fromRGB(57, 255, 20) -- neon green
		else
			circle.BackgroundColor3 = Color3.fromRGB(255, 20, 20) -- neon red
		end
	end)
end
coroutine.wrap(WGFO_fake_script)()
