	refreshSelectedEvent.Name = "RefreshSelected"
	refreshSelectedEvent.Parent = panel
	
	local function removeEventPrefix(displayName)
		local text = tostring(displayName)
		-- Replace underscores and hyphens with spaces
		text = text:gsub("[_%-]", " ")
		-- Remove 4-digit years (like 2026)
		text = text:gsub("%d%d%d%d", "")
		-- Clean up extra spaces
		text = text:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
		return text
	end
	
	local function capitalizeWords(displayName)
		local text = displayName:gsub("(%S+)", function(word)
			return word:sub(1, 1):upper() .. word:sub(2):lower()
		end)
		-- Remove consecutive duplicate words anywhere (e.g., "Egg Egg" -> "Egg")
		text = text:gsub("(%a+)%s+%1", "%1")
		return text
	end
	
	local function getDisplayName(itemData)
		local properties = itemData.properties or {}
		local displayName = properties.name
			or properties.custom_name
			or properties.display_name
			or itemData.display_name
			or itemData.displayName
			or itemData.name
			or itemData.kind
			or "Unknown egg"
	
		-- Convert pet_recycler_YYYY_<egg> IDs to just the egg name
		local kind = tostring(itemData.kind or "")
		local recyclerEgg = kind:match("^pet_recycler_%d+_(.+)$")
		if recyclerEgg then
			displayName = recyclerEgg
		end
	
		local cleanedName = removeEventPrefix(displayName)
		return capitalizeWords(cleanedName)
	end
	
	local KindDB = require(
		ReplicatedStorage
			:WaitForChild("ClientDB")
			:WaitForChild("Inventory")
			:WaitForChild("KindDB")
	)
	
	local function isEgg(itemData)
		if not itemData then
			return false
		end
	
		local kind = tostring(itemData.kind or "")
		local lowerKind = string.lower(kind)
	
		-- Exclude basic_egg_2022 pet entries
		if string.find(lowerKind, "^basic_egg_2022_", 1) then
			return false
		end
	
		local kindData = KindDB[kind]
	
		if kindData then
			if kindData.is_egg == true then
				return true
			end
	
			local category = string.lower(tostring(kindData.category or ""))
	
			if category == "egg" or category == "eggs" then
				return true
			end
		end
	
		-- Fallback for actual egg IDs
		return string.find(lowerKind, "egg", 1, true) ~= nil
	end
	
	local function clearList()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
