	local function syncSelectedEggs()
		selectedEggs:ClearAllChildren()
		local selectedIndex = 0
		for group in pairs(selectedGroups) do
			for index = 1, math.min(#group.uniqueIds, 18) do
				selectedIndex += 1
				local eggId = Instance.new("StringValue")
				eggId.Name = "Egg_" .. selectedIndex
				eggId.Value = tostring(group.uniqueIds[index])
				eggId.Parent = selectedEggs
			end
		end
	end
	
