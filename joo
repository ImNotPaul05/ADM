	local successClientData, ClientData = pcall(function()
		return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
	end)
	local selectedGroups = {}
	local refreshSelectedEvent = Instance.new("BindableEvent")
	refreshSelectedEvent.Name = "RefreshSelected"
	refreshSelectedEvent.Parent = panel
	
	local function removeEventPrefix(displayName)
		local cleanedName = tostring(displayName):gsub("^[%a%s_%-]+%d%d%d%d[%s_%-]+", "")
		return cleanedName:gsub("^%s+", ""):gsub("%s+$", "")
	end
	
	local KindDB = require(
		ReplicatedStorage
			:WaitForChild("ClientDB")
			:WaitForChild("Inventory")
			:WaitForChild("KindDB")
	)
	
	local function capitalizeWords(displayName)
		return displayName:gsub("(%S+)", function(word)
			return word:sub(1, 1):upper() .. word:sub(2):lower()
		end)
	end
	
	local function getDisplayName(itemData)
		local kind = tostring(itemData.kind or "")
		local kindData = KindDB[kind]
	
		-- Use the actual pet name from KindDB
		if kindData and kindData.name and kindData.name ~= "" then
			return tostring(kindData.name)
		end
	
		-- Fallback
		local properties = itemData.properties or {}
		local displayName = properties.name
			or properties.custom_name
			or properties.display_name
			or itemData.display_name
			or itemData.displayName
			or itemData.name
			or kind
	
		if displayName and displayName ~= "" then
			local cleanedName = removeEventPrefix(displayName)
	
			if cleanedName ~= "" then
				return capitalizeWords(cleanedName)
			end
		end
	
		return capitalizeWords(
			removeEventPrefix(kind:gsub("[_%-]", " "))
		)
	end
	
	local function getForm(itemData)
		local properties = itemData.properties or {}
		if properties.mega_neon then
			return "Mega"
		elseif properties.neon then
			return "Neon"
		end
		return "Normal"
	end
	
	local formOrder = {
		Mega = 1,
		Neon = 2,
		Normal = 3,
	}
	
	local function isPet(itemData)
		if not itemData then
			return false
		end
	
		local kind = tostring(itemData.kind or "")
		local kindData = KindDB[kind]
	
		if kindData then
			-- KindDB is the main source
			if kindData.is_egg == true then
				return false
			end
	
			if string.lower(tostring(kindData.category or "")) == "pets" then
				return true
			end
		end
	
		-- Fallback for pet_recycler items / unknown KindDB entries
		if string.find(string.lower(kind), "egg", 1, true) then
			return false
		end
	
		return true
	end
	
	local function isPracticeDog(itemData)
		local properties = itemData.properties or {}
		local kind = string.lower(tostring(itemData.kind or ""))
		local displayName = string.lower(tostring(
			properties.name
				or properties.custom_name
				or properties.display_name
				or itemData.display_name
				or itemData.displayName
				or itemData.name
				or ""
			))
		return kind == "practice_dog"
			or string.find(kind, "practice_dog", 1, true) ~= nil
			or string.find(displayName, "practice dog", 1, true) ~= nil
	end
	
