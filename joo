local function C_1c()
local script = G2L["1c"];
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	local localPlayer = Players.LocalPlayer
	local panel = script.Parent
	local refreshButton = panel.Parent:WaitForChild("RefreshPet/Button")
	local selectedPets = Instance.new("Folder")
	selectedPets.Name = "SelectedPets"
	selectedPets.Parent = panel
	
	local list = Instance.new("ScrollingFrame")
	list.Name = "PetList"
	list.Parent = panel
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(8, 8)
	list.Size = UDim2.new(1, -16, 1, -16)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.ScrollBarThickness = 6
	
