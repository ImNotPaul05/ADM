		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
	end
	
	local function syncSelectedPets()
		selectedPets:ClearAllChildren()
		local selectedIndex = 0
		for group in pairs(selectedGroups) do
			for index = 1, math.min(#group.uniqueIds, 18) do
				selectedIndex += 1
				local petId = Instance.new("StringValue")
				petId.Name = "Pet_" .. selectedIndex
				petId.Value = tostring(group.uniqueIds[index])
				petId.Parent = selectedPets
			end
		end
	end
	
	local function refreshPets()
		local selectedKeys = {}
	
		for group in pairs(selectedGroups) do
			selectedKeys[group.displayName .. "|" .. group.form] = true
		end
	
		-- Never destroy the current selection until a valid inventory snapshot is ready.
		if not successClientData or not ClientData then
			return false
		end
	
		local dataStore = ClientData.get_data()
		local playerData = dataStore and (dataStore[localPlayer] or dataStore[localPlayer.Name])
		local pets = playerData and playerData.inventory and playerData.inventory.pets
	
		if not pets then
			return false
		end
	
		local groupedPets = {}
	
		for uniqueId, itemData in pairs(pets) do
			if itemData and isPet(itemData) and not isPracticeDog(itemData) then
				local displayName = getDisplayName(itemData)
				local form = getForm(itemData)
				local key = displayName .. "|" .. form
				local group = groupedPets[key]
	
				if not group then
					group = {
						displayName = displayName,
						form = form,
						uniqueIds = {}
					}
					groupedPets[key] = group
				end
	
				table.insert(group.uniqueIds, uniqueId)
			end
		end
	
		local groups = {}
		for _, group in pairs(groupedPets) do
			table.insert(groups, group)
		end
	
		table.sort(groups, function(left, right)
			local leftOrder = formOrder[left.form] or 4
			local rightOrder = formOrder[right.form] or 4
	
			if leftOrder == rightOrder then
				return left.displayName < right.displayName
			end
	
			return leftOrder < rightOrder
		end)
	
		-- Only replace the UI/selection after the entire snapshot was built successfully.
		clearList()
		selectedGroups = {}
	
		for groupIndex, group in ipairs(groups) do
			local button = Instance.new("TextButton")
			button.Name = group.displayName .. "_" .. group.form
			button.Parent = list
			button.LayoutOrder = (formOrder[group.form] or 4) * 100000 + groupIndex
			button.Size = UDim2.new(1, -6, 0, 32)
			button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			button.BorderSizePixel = 0
			button.Font = Enum.Font.SourceSansBold
	
			local formLabel = group.form
			button.Text = string.format("%s %s ×%d", formLabel, group.displayName, #group.uniqueIds)
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextSize = 16
			button.TextXAlignment = Enum.TextXAlignment.Center
			button.AutoButtonColor = true
			Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)
	
			if selectedKeys[group.displayName .. "|" .. group.form] and #group.uniqueIds > 0 then
				selectedGroups[group] = true
				button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
			end
	
			button.Activated:Connect(function()
				if selectedGroups[group] then
					selectedGroups[group] = nil
					button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
					print("Deselected pet:", button.Text)
				else
					selectedGroups[group] = true
					button.BackgroundColor3 = Color3.fromRGB(158, 0, 158)
					print("Selected pet:", button.Text)
				end
				syncSelectedPets()
			end)
		end
	
		-- Rebuild the actual IDs only after the fresh inventory snapshot is installed.
		syncSelectedPets()
	
		panel:SetAttribute("RefreshSelectedVersion",
			(panel:GetAttribute("RefreshSelectedVersion") or 0) + 1
		)
	
		return true
	end
	
	refreshButton.Activated:Connect(function()
		for _ = 1, 5 do
			if refreshPets() then
				return
			end
			task.wait(0.1)
		end
	end)
	
	refreshSelectedEvent.Event:Connect(function()
		for _ = 1, 8 do
			if refreshPets() then
				return
			end
			task.wait(0.1)
		end
	end)
	
	refreshPets()
	panel:SetAttribute("RefreshSelectedReady", true)
	panel:SetAttribute("RefreshSelectedVersion", panel:GetAttribute("RefreshSelectedVersion") or 0)
	end
end;
