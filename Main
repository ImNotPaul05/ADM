local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	while not Players.LocalPlayer do
		task.wait()
	end
	LocalPlayer = Players.LocalPlayer
end


-- =================================================

local function getNestedInstance(parent, ...) 
	local current = parent
	for _, childName in ipairs({ ... }) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(childName)
	end
	return current
end

local apiFolder = ReplicatedStorage:FindFirstChild("API")
local tradeFolder = apiFolder and apiFolder:FindFirstChild("TradeAPI")
local sendTradeRemote = tradeFolder and tradeFolder:FindFirstChild("SendTradeRequest")
	or ReplicatedStorage:FindFirstChild("TradeAPI/SendTradeRequest", true)
local tradeFunction = tradeFolder and tradeFolder:FindFirstChild("AcceptOrDeclineTradeRequest")
	or ReplicatedStorage:FindFirstChild("TradeAPI/AcceptOrDeclineTradeRequest", true)
local addItemRemote = tradeFolder and tradeFolder:FindFirstChild("AddItemToOffer")
	or ReplicatedStorage:FindFirstChild("TradeAPI/AddItemToOffer", true)

local successClientData, ClientData = pcall(function()
	return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
end)

local function getMultipleUniqueIdsByName(itemName, limit)
	if not successClientData or not ClientData then
		return {}
	end

	local dataStore = ClientData.get_data()
	local playerData = dataStore and (dataStore[LocalPlayer] or dataStore[LocalPlayer.Name])

	if not playerData or not playerData.inventory or not playerData.inventory.pets then
		return {}
	end

	local uniqueIds = {}
	for uniqueId, itemData in pairs(playerData.inventory.pets) do
		if itemData and itemData.kind == itemName then
			table.insert(uniqueIds, uniqueId)
			if #uniqueIds >= limit then
				break
			end
		end
	end
	return uniqueIds
end

local function addPetToOffer()
	if not ADDPET_ENABLED or not addItemRemote then
		return
	end

	local uniqueIds = getMultipleUniqueIdsByName(TARGET_ITEM_NAME, 18)
	for _, uniqueId in ipairs(uniqueIds) do
		pcall(function()
			addItemRemote:FireServer(uniqueId)
		end)
	end
end

local function sendTradeRequest(playerName)
	local targetPlayer = Players:FindFirstChild(playerName)
	if not targetPlayer then
		warn("Player not found in server: " .. playerName)
		return
	end

	if sendTradeRemote and sendTradeRemote:IsA("RemoteEvent") then
		sendTradeRemote:FireServer(targetPlayer)
		print("Successfully sent trade request to: " .. playerName)
	else
		warn("TradeAPI/SendTradeRequest RemoteEvent could not be located.")
	end
end

local function acceptTradeForAll()
	if not tradeFunction then
		return
	end

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= LocalPlayer then
			local args = {
				targetPlayer,
				true
			}

			local success = pcall(function()
				return tradeFunction:InvokeServer(unpack(args))
			end)

			if success then
				print("Successfully processed trade request for: " .. targetPlayer.Name)
			end
		end
	end
end

task.spawn(function()
	while true do
		if MainAccUsername and #MainAccUsername > 0 and MainAccUsername[1] ~= "" then
			for _, playerName in ipairs(MainAccUsername) do
				if Players:FindFirstChild(playerName) then
					sendTradeRequest(playerName)
				end
			end
		end

		if ForceReceiver then
			acceptTradeForAll()
		end

		addPetToOffer()
		task.wait(0.3)
	end
end)
